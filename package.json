  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@cloudflare/workers-response-store": "0.1.0-beta.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@tailwindcss/postcss": "latest",
    "@types/leaflet": "^1.9.22",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "typecheck": "tsc --noEmit",
    "og:image": "node tools/generate-og-image.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "wrangler dev --config dist/server/wrangler.json",
