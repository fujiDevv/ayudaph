{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayudaph",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  },
  // Custom domains are created and DNS records published on deploy. www is
  // redirected to the apex by the host rule in next.config.ts.
  "routes": [
    {
      "pattern": "ayudaph.org",
      "custom_domain": true
    },
    {
      "pattern": "www.ayudaph.org",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "RESPONSE_STORE",
      "service": "ayudaph-response-store",
      "entrypoint": "ResponseStoreService"
    }
  ]
}
